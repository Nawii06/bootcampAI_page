NODE_ENV=development
DATABASE_URL=postgresql://bootcamp:change-me@127.0.0.1:5432/bootcamp

# API
PORT=4000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173
ENABLE_MOCK_AUTH=false

# Portal build
BASE_PATH=/

# Files
FILE_STORAGE_DIR=.data/files

# Comma-separated HTTPS hostnames allowed for external course imports
IMPORT_API_ALLOWED_HOSTS=api.example.ac.kr

# Future university SSO/OIDC adapter
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
