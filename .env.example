NODE_ENV=development
POSTGRES_DB=bootcamp
POSTGRES_USER=bootcamp
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bootcamp:change-me-for-local-development@127.0.0.1:5432/bootcamp
# Production alternative: DATABASE_URL_FILE=/run/secrets/database_url
MIGRATION_DATABASE_URL_FILE=
MIGRATION_EXPECTED_USER=bootcamp_migrator
BACKUP_DATABASE_URL_FILE=
BACKUP_DIR=.data/backups
RESTORE_DATABASE_URL_FILE=
SEED_PROFILE=development

# API
PORT=4000
PORTAL_PORT=4173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173
ENABLE_MOCK_AUTH=false
TRUST_PROXY_HOPS=0
LOG_LEVEL=info

# Internal Prometheus metrics. Use a random value of at least 32 characters.
METRICS_ENABLED=false
METRICS_TOKEN=
# Production alternative: METRICS_TOKEN_FILE=/run/secrets/metrics_token
TLS_TERMINATED_AT=ingress

# Portal build
BASE_PATH=/

# Files
FILE_STORAGE_DRIVER=local
FILE_STORAGE_DIR=.data/files
# S3-compatible storage (required when FILE_STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_KEY_PREFIX=bootcamp
S3_SIGNED_URL_EXPIRES_SECONDS=120
# Leave credentials unset when the runtime receives an IAM role/workload identity.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# File malware scanning. Production requires http mode and an HTTPS endpoint.
MALWARE_SCAN_MODE=disabled
MALWARE_SCAN_URL=
MALWARE_SCAN_API_KEY=
# Production alternative: MALWARE_SCAN_API_KEY_FILE=/run/secrets/malware_scan_api_key
MALWARE_SCAN_TIMEOUT_MS=10000

# Comma-separated HTTPS hostnames allowed for external course imports
IMPORT_API_ALLOWED_HOSTS=api.example.ac.kr

# Future university SSO/OIDC adapter
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
