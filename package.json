{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "db:up": "docker compose --env-file .env up -d --wait postgres",
    "db:down": "docker compose --env-file .env down",
    "db:migrate": "pnpm --filter @workspace/db migrate",
    "db:seed": "pnpm --filter @workspace/db seed",
    "db:verify": "pnpm --filter @workspace/db verify",
    "db:migrate:production": "node scripts/run-migrations.mjs",
    "db:backup": "node scripts/postgres-backup.mjs backup",
    "db:backup:verify": "node scripts/postgres-backup.mjs verify",
    "db:restore": "node scripts/postgres-backup.mjs restore",
    "db:reset": "node scripts/db-reset.mjs",
    "fake-data:list": "node scripts/fake-data-set.mjs list",
    "fake-data:validate": "node scripts/fake-data-set.mjs validate",
    "fake-data:remove": "node scripts/fake-data-set.mjs remove",
    "verify": "pnpm secret-scan:tracked && pnpm secret-scan:test && pnpm deploy:check:test && pnpm db:ops:test && pnpm release:manifest:test && pnpm release:approval:test && pnpm --filter @workspace/api-server test && pnpm --filter @workspace/bootcamp-portal test && pnpm build",
    "secret-scan:tracked": "node scripts/secret-scan.mjs --tracked",
    "secret-scan:test": "node --test scripts/secret-scan.test.mjs",
    "deploy:check": "node scripts/production-readiness.mjs",
    "deploy:check:test": "node --test scripts/production-readiness.test.mjs",
    "db:ops:test": "node --test scripts/postgres-operations.test.mjs",
    "release:manifest": "node scripts/release-manifest.mjs generate",
    "release:manifest:verify": "node scripts/release-manifest.mjs verify",
    "release:manifest:test": "node --test scripts/release-manifest.test.mjs",
    "release:approval:validate": "node scripts/release-approval.mjs",
    "release:approval:test": "node --test scripts/release-approval.test.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "@esbuild/win32-x64": "^0.27.3",
    "@rollup/rollup-win32-x64-msvc": "^4.62.0",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.0",
    "lightningcss-win32-x64-msvc": "1.32.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
